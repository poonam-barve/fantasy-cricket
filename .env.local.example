# Copy this file to `.env.local` and edit the values for your machine.
# This file is for local development only.

# Local database mode
# Option 1: SQLite local development
# DATABASE_URL=

# Option 2: Local PostgreSQL development
# Use the real local PostgreSQL role you can log in with.
DATABASE_URL=postgresql://postgres@localhost:5432/FantasyDBLocal
# Optional admin connection used only to create the database if it does not exist.
# POSTGRES_ADMIN_URL=postgresql://postgres@localhost:5432/postgres

# Optional app settings
SECRET_KEY=your-local-secret-key
TEST_MODE=False
# Set to 1 to skip automatic workbook seeding during local startup.
SKIP_DB_SEED=1
# Override the app's notion of "now" for local testing.
# Set both values together, or use APP_CURRENT_DATETIME instead.
APP_CURRENT_DATE=2026-04-26
APP_CURRENT_TIME=19:30
# Optional combined override: APP_CURRENT_DATETIME=2026-04-26 19:30

# Frontend mobile preview is configured separately for Vite.
# Copy frontend/.env.local.example to frontend/.env.local and set VITE_MOBILE_MODE=1 if needed.

# Firebase credentials for local development
# Keep this separate from any live credentials.
# Leave blank unless you have a valid Firebase service account JSON.
